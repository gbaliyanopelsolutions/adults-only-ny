{{ 'ao-base.css' | asset_url | stylesheet_tag }}
{{ 'ao-pages.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Sitemap — one group per navigation menu. The archive group in the design is
  three columns of nested lists (category → products), the manifesto and
  support groups are flat link grids; both come out of the same markup because
  a group simply renders its menu two levels deep.
{%- endcomment -%}

{%- liquid
  assign t = section.settings

  assign heading = t.title
  if heading == blank and page.title != blank
    assign heading = page.title
  endif
-%}

{% render 'ao-page-style', section: section %}

<div id="ao-{{ section.id }}" class="ao-page ao-sitemap">
  <div class="ao-page__inner">
    {% render 'ao-masthead',
      show_crest: t.show_crest,
      crest: t.crest,
      crest_width: t.crest_width,
      tagline: t.tagline,
      title: heading,
      body: t.body
    %}

    <div class="ao-sitemap__groups">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign menu = linklists[b.menu]
          assign group_heading = b.heading
          if group_heading == blank
            assign group_heading = menu.title
          endif
        -%}
        {%- if menu.links.size > 0 -%}
          <section class="ao-sitemap__group" {{ block.shopify_attributes }}>
            {%- if group_heading != blank -%}
              <h2 class="ao-sitemap__group-heading">{{ group_heading }}</h2>
            {%- endif -%}

            <ul class="ao-sitemap__columns ao-sitemap__columns--{{ b.columns | default: 3 }}" role="list">
              {%- for link in menu.links -%}
                <li class="ao-sitemap__column">
                  <a class="ao-sitemap__top-link" href="{{ link.url }}">{{ link.title }}</a>

                  {%- if link.links.size > 0 -%}
                    <ul class="ao-sitemap__sublist" role="list">
                      {%- for child in link.links -%}
                        <li>
                          <a class="ao-sitemap__mid-link" href="{{ child.url }}">{{ child.title }}</a>

                          {%- if child.links.size > 0 -%}
                            <ul class="ao-sitemap__leaflist" role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a class="ao-sitemap__leaf-link" href="{{ grandchild.url }}">
                                    {{ grandchild.title }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.ao-sitemap__groups {
  display: flex;
  flex-direction: column;
  gap: 56px;
  margin-top: 40px;
}
.ao-sitemap__group-heading {
  margin: 0 0 24px;
  padding-bottom: 8px;
  font-family: var(--ao-h);
  font-size: 24px;
  font-weight: 700;
  line-height: 1.2;
  text-transform: uppercase;
}
.ao-sitemap__columns {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.ao-sitemap__column {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ao-sitemap__top-link {
  color: inherit;
  font-size: 18px;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
}
.ao-sitemap__sublist {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin: 8px 0 0;
  padding: 0;
  list-style: none;
}
.ao-sitemap__mid-link {
  display: block;
  padding: 0 8px;
  color: inherit;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
}
.ao-sitemap__leaflist {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 8px 0 0;
  padding: 0;
  list-style: none;
}
.ao-sitemap__leaf-link {
  display: block;
  padding: 0 16px;
  color: inherit;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
}
.ao-sitemap__top-link:hover,
.ao-sitemap__mid-link:hover,
.ao-sitemap__leaf-link:hover {
  color: var(--ao-page-accent);
}

@media screen and (min-width: 750px) {
  .ao-sitemap__columns--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ao-sitemap__columns--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ao-sitemap__columns--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ao-sitemap__columns { gap: 64px 32px; }
  .ao-sitemap__group-heading { font-size: 30px; }
  .ao-sitemap__top-link { font-size: 22px; }
}

@media screen and (min-width: 990px) {
  .ao-sitemap__groups { gap: 80px; margin-top: 56px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "AO Sitemap",
  "tag": "section",
  "class": "ao-sitemap-section",
  "settings": [
    { "type": "header", "content": "Masthead" },
    { "type": "checkbox", "id": "show_crest", "label": "Show crest", "default": true },
    { "type": "image_picker", "id": "crest", "label": "Crest image", "info": "Leave blank to use the bundled AO lockup." },
    { "type": "range", "id": "crest_width", "min": 60, "max": 200, "step": 1, "unit": "px", "label": "Crest width (desktop)", "default": 137 },
    { "type": "range", "id": "crest_width_mobile", "min": 40, "max": 140, "step": 1, "unit": "px", "label": "Crest width (mobile)", "default": 77 },
    { "type": "text", "id": "tagline", "label": "Tagline" },
    { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the page title." },
    { "type": "richtext", "id": "body", "label": "Intro copy" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ed117c" },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "montserrat_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "noto_sans_n4" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "min": 600, "max": 1440, "step": 20, "unit": "px", "label": "Content max width", "default": 1120 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 128 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 96 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 64 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Menu group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the menu title." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
        { "type": "select", "id": "columns", "label": "Columns", "default": "3",
          "options": [
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AO Sitemap",
      "blocks": [{ "type": "group" }]
    }
  ]
}
{% endschema %}
