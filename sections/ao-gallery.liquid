{{ 'ao-base.css' | asset_url | stylesheet_tag }}
{{ 'ao-pages.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The Gallery page mixes two card sizes in one flow: a four-up row of dated
  journal cards and a two-up row of large captioned images. Both live in a
  single 12-column grid — a card spans 3 columns, a feature spans 6 — so any
  mix of blocks lays out correctly without grouping logic.
{%- endcomment -%}

{%- liquid
  assign t = section.settings

  assign heading = t.title
  if heading == blank and page.title != blank
    assign heading = page.title
  endif
-%}

{% render 'ao-page-style', section: section %}

<div id="ao-{{ section.id }}" class="ao-page ao-gallery">
  <div class="ao-page__inner">
    {% render 'ao-masthead',
      show_crest: t.show_crest,
      crest: t.crest,
      crest_width: t.crest_width,
      tagline: t.tagline,
      title: heading
    %}

    {%- if t.body != blank -%}
      <div class="ao-gallery__intro rte">{{ t.body }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ao-gallery__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              <h2 class="ao-row-heading ao-gallery__heading" {{ block.shopify_attributes }}>
                {{ b.heading }}
              </h2>

            {%- when 'card' -%}
              <article class="ao-gallery__card" {{ block.shopify_attributes }}>
                {%- if b.image != blank -%}
                  <div class="ao-gallery__card-media">
                    {{
                      b.image
                      | image_url: width: 800
                      | image_tag:
                        class: 'ao-gallery__img',
                        widths: '256, 400, 600, 800',
                        sizes: '(min-width: 990px) 256px, (min-width: 750px) 30vw, 90vw',
                        loading: 'lazy',
                        alt: b.title | default: shop.name | escape
                    }}
                  </div>
                {%- endif -%}

                <div class="ao-gallery__card-body">
                  {%- if b.title != blank -%}
                    <h3 class="ao-gallery__card-title">{{ b.title }}</h3>
                  {%- endif -%}
                  {%- if b.text != blank -%}
                    <div class="ao-gallery__card-text rte">{{ b.text }}</div>
                  {%- endif -%}
                  {%- if b.date != blank -%}
                    <p class="ao-gallery__card-date">{{ b.date }}</p>
                  {%- endif -%}
                </div>

                {%- if b.button_label != blank -%}
                  <div class="ao-gallery__card-action">
                    <a class="ao-btn ao-btn--outline" href="{{ b.button_link | default: '#' }}">
                      {{ b.button_label }}
                    </a>
                  </div>
                {%- endif -%}
              </article>

            {%- when 'feature' -%}
              <article class="ao-gallery__feature" {{ block.shopify_attributes }}>
                {%- if b.image != blank -%}
                  <div class="ao-gallery__feature-media">
                    {{
                      b.image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'ao-gallery__img',
                        widths: '540, 800, 1080, 1600',
                        sizes: '(min-width: 990px) 540px, 90vw',
                        loading: 'lazy',
                        alt: b.title | default: shop.name | escape
                    }}
                  </div>
                {%- endif -%}
                <div class="ao-gallery__feature-body">
                  {%- if b.title != blank -%}
                    <h3 class="ao-gallery__feature-title">{{ b.title }}</h3>
                  {%- endif -%}
                  {%- if b.caption != blank -%}
                    <p class="ao-gallery__feature-caption">{{ b.caption }}</p>
                  {%- endif -%}
                </div>
                {%- if b.link != blank -%}
                  <a class="ao-gallery__feature-link" href="{{ b.link }}">
                    <span class="visually-hidden">{{ b.title }}</span>
                  </a>
                {%- endif -%}
              </article>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ao-empty">{{ t.empty_text | default: 'The archive is being hung. Check back soon.' }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ao-gallery__intro {
  margin-top: 24px;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
}
.ao-gallery__intro > :first-child { margin-top: 0; }
.ao-gallery__intro > :last-child { margin-bottom: 0; }
.ao-gallery__intro a { color: var(--ao-page-accent); }

.ao-gallery__grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 40px 24px;
  margin-top: 40px;
}
/* Full-bleed heading row */
.ao-gallery__heading {
  grid-column: 1 / -1;
  margin: 0;
}
/* Cards are half-width on mobile, quarter-width from tablet up */
.ao-gallery__card { grid-column: span 3; }
.ao-gallery__feature { grid-column: 1 / -1; }

.ao-gallery__card,
.ao-gallery__feature {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin: 0;
}
.ao-gallery__feature { position: relative; }
.ao-gallery__card-media,
.ao-gallery__feature-media {
  overflow: hidden;
  border-radius: var(--ao-radius, 8px);
  background: var(--ao-surface-2);
}
.ao-gallery__card-media { aspect-ratio: 16 / 15; }
.ao-gallery__feature-media { aspect-ratio: 5 / 4; }
.ao-gallery__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ao-gallery__card-body,
.ao-gallery__feature-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ao-gallery__card-title {
  margin: 0;
  font-family: var(--ao-h);
  font-size: 18px;
  font-weight: 700;
  line-height: 1.2;
}
.ao-gallery__card-text {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
}
.ao-gallery__card-text > :first-child { margin-top: 0; }
.ao-gallery__card-text > :last-child { margin-bottom: 0; }
.ao-gallery__card-date {
  margin: 8px 0 0;
  font-size: 14px;
  font-weight: 600;
  opacity: 0.8;
}
.ao-gallery__card-action {
  display: flex;
  justify-content: center;
  margin-top: auto;
}
.ao-gallery__feature-title {
  margin: 0;
  font-family: var(--ao-h);
  font-size: 20px;
  font-weight: 700;
  line-height: 1.2;
  text-transform: uppercase;
}
.ao-gallery__feature-caption {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
}
/* Whole-card link overlay, so the caption text stays selectable */
.ao-gallery__feature-link {
  position: absolute;
  inset: 0;
}

@media screen and (min-width: 750px) {
  .ao-gallery__grid {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 64px 32px;
  }
  .ao-gallery__card { grid-column: span 3; }
  .ao-gallery__feature { grid-column: span 6; }
  .ao-gallery__feature-title { font-size: 24px; }
}

@media screen and (min-width: 990px) {
  .ao-gallery__intro { font-size: 20px; }
  .ao-gallery__grid { gap: 64px 32px; margin-top: 64px; }
  .ao-gallery__card-title { font-size: 20px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "AO Gallery",
  "tag": "section",
  "class": "ao-gallery-section",
  "settings": [
    { "type": "header", "content": "Masthead" },
    { "type": "checkbox", "id": "show_crest", "label": "Show crest", "default": true },
    { "type": "image_picker", "id": "crest", "label": "Crest image", "info": "Leave blank to use the bundled AO lockup." },
    { "type": "range", "id": "crest_width", "min": 60, "max": 200, "step": 1, "unit": "px", "label": "Crest width (desktop)", "default": 137 },
    { "type": "range", "id": "crest_width_mobile", "min": 40, "max": 140, "step": 1, "unit": "px", "label": "Crest width (mobile)", "default": 77 },
    { "type": "text", "id": "tagline", "label": "Tagline" },
    { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the page title." },
    { "type": "richtext", "id": "body", "label": "Intro copy", "info": "Rendered left-aligned under the masthead." },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "The archive is being hung. Check back soon." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ed117c" },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "montserrat_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "noto_sans_n4" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "min": 600, "max": 1440, "step": 20, "unit": "px", "label": "Content max width", "default": 1120 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 128 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 96 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 64 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Row heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "LOREM IPSUM" }
      ]
    },
    {
      "type": "card",
      "name": "Journal card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Lorem Ipsum Resti" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "READ" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Lorem Ipsum Resti" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AO Gallery",
      "blocks": [
        { "type": "heading" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
